# Documents environment variables; this file is NOT loaded automatically.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_REVIEW_MODEL=gpt-5
NAVER_BLOG_ID=
NAVER_ID=
NAVER_PASSWORD=
# Keep state OUTSIDE the checkout, which actions/checkout cleans.
BLOG_DATA_DIR=C:\blogbot\data
BLOG_INBOX_DIR=C:\blogbot\data\inbox
NAVER_PROFILE_DIR=C:\blogbot\chrome-profile
BLOG_DAILY_COUNT=3
NAVER_HEADLESS=false
BLOG_NOTIFY_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API-only cloud preparation; values belong in GitHub Secrets, never this file.
BLOG_BUNDLE_KEY=
BLOG_SEED_JSON=

# Optional NAVER API HUB search-trend credentials, distinct from browser login.
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
